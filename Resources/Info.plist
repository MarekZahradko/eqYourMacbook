<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.zdenekkops.eqyourmacbook</string>
    <key>CFBundleName</key>
    <string>eqYourMacbook</string>
    <key>CFBundleDisplayName</key>
    <string>eqYourMacbook</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.1</string>
    <key>CFBundleVersion</key>
    <string>2</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <!-- No Dock icon — menu bar only app -->
    <key>LSUIElement</key>
    <true/>
    <!-- NSAudioCaptureUsageDescription must be set manually; Xcode's dropdown doesn't expose it (CLAUDE.md § Invariants: TCC) -->
    <key>NSAudioCaptureUsageDescription</key>
    <string>eqYourMacbook captures system audio to apply the equalizer to the built-in speakers.</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
</dict>
</plist>
